# ccm-feedback environment variables
#
# These are NOT read by the widget at runtime. The widget gets its config
# from the <script> tag's data-* attributes (or window.CcmFeedback.init()).
#
# This file exists for the maintainer's local Supabase tooling
# (e.g. `supabase db push`, scripts that seed or inspect the demo project).
#
# To self-host:
#   1. Create a Supabase project at https://supabase.com/dashboard
#   2. Run the SQL files in supabase/migrations/ in order
#   3. Copy your project URL + anon key into the <script> tag:
#        <script
#          src="https://YOUR-HOST/w.js"
#          data-project="my-site"
#          data-supabase-url="https://YOURREF.supabase.co"
#          data-supabase-key="YOUR_ANON_KEY"
#          defer
#        ></script>
#
# Leave these blank (or omit the data-* attrs) and the widget runs in
# localStorage-only mode — no infra required.

# Public URL of your Supabase project. Same value as data-supabase-url.
SUPABASE_URL=

# Anon / publishable key — browser-safe. Same value as data-supabase-key.
SUPABASE_ANON_KEY=

# Service-role key — full DB access. NEVER expose this in the browser or
# commit it. Used only by maintainer scripts (db push, backfills, etc.).
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 measurement ID for the landing page (feedback.ccmdesign.ca).
# Source of truth for the analytics property — mirror this value into
# public/index.html (both the gtag.js <script src> and the gtag('config', ...)
# call). The HTML is static; no build step substitutes this at runtime.
GA_ID=
