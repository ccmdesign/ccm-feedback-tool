# Supabase Postgres (required for persistent storage — optional for local memory-store mode)
#
# Pooler URL (pgbouncer, port 6543) — used at runtime.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# Direct URL (port 5432) — used by Prisma migrations and introspection.
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Leave both unset to run the demo against an ephemeral in-memory store.
# See docs/local-dev.md for the full runbook.

# --- CCM-279 — Supabase Auth + admin allowlist ---
#
# Supabase Auth for the /admin/* surface.
# Project: ccm-feedback-prod (ref qnkvkumtssihbjmocbtv).
# NEXT_PUBLIC_SUPABASE_URL="https://qnkvkumtssihbjmocbtv.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"  # server-only; used by admin.ts placeholder

# Admin allowlist (comma-separated). Unset defaults to ["dev@ccmdesign.ca"].
# CCM_ADMIN_ALLOWLIST="dev@ccmdesign.ca,ops@example.com"

# Optional bearer token for the POST /api/v1/annotations/:id/status callback.
# When set, requires Authorization: Bearer <token>. Default: off.
# CCM_CALLBACK_BEARER_TOKEN=""

# --- CCM-279 — Webhook dispatch plaintext secrets (dev/local only) ---
#
# The dispatcher caches plaintext secrets in-process (populated on project
# create/rotate). For standalone scripts and tests, you can pass plaintext
# per project via CCM_DISPATCH_SECRET_<projectId>.
# CCM_DISPATCH_SECRET_<projectId>="<plaintext>"

# --- CCM-282 — Asset mirroring / image_swap ---
#
# CCM-hosted storage origin used by:
#   (a) the validation layer to enforce that `proposedAssetUrl` is CCM-hosted,
#   (b) the mirror handler short-circuit when a reviewer pastes an already-
#       mirrored URL,
#   (c) the webhook payload builder when annotating image_swap rows.
#
# Defaults to "${NEXT_PUBLIC_SUPABASE_URL}/storage/v1/object/public/assets/"
# and falls back to http://localhost:54321/... for local Supabase dev.
# Set explicitly when you front Storage with a custom CDN.
# CCM_STORAGE_ORIGIN="https://assets.feedback.ccmdesign.ca/"

# --- E2E / test harness ---
#
# Enable the admin middleware bypass for Playwright runs. NEVER set in prod.
# CCM_E2E_ADMIN_BYPASS="1"

# --- CCM-284 — Voice comment pipeline (POST /api/v1/transcribe) ---
#
# Whisper transcription (OpenAI). Required for /api/v1/transcribe.
# OPENAI_API_KEY="<openai-api-key>"
#
# Cleanup pass (OpenRouter). Required for /api/v1/transcribe.
# OPENROUTER_API_KEY="<openrouter-api-key>"
#
# Override the cleanup model slug. OpenRouter rotates DeepSeek slugs — the
# transcribe handler defaults to "deepseek/deepseek-chat-v3.1:free" when unset.
# Pin an exact slug here if the default drifts.
# CCM_CLEANUP_MODEL="deepseek/deepseek-chat-v3.1:free"
#
# When true, the transcribe handler uploads the raw audio blob to Supabase
# Storage (bucket name defaults to "audio", overridable below) and returns
# the resulting public URL on each response + webhook payload. Requires
# NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY to be set above.
# CCM_FEEDBACK_STORE_AUDIO="false"
# SUPABASE_AUDIO_BUCKET="audio"

# Comma-separated allowed origins for widget-facing CORS. Only configured for
# /api/v1/transcribe today (CCM-284). Leave unset for same-origin dev.
# Example: "https://app.example.com,https://app.staging.example.com"
# CCM_FEEDBACK_ALLOWED_ORIGINS=""
