{
  "name": "ccm-feedback",
  "version": "0.1.0",
  "private": true,
  "description": "CCM Feedback — single-script-tag feedback widget. Pin comments on any element, export JSON.",
  "homepage": "https://ccm-feedback-582.netlify.app",
  "type": "module",
  "author": "ccmdesign",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccmdesign/ccm-feedback-tool.git"
  },
  "bugs": {
    "url": "https://github.com/ccmdesign/ccm-feedback-tool/issues"
  },
  "packageManager": "bun@1.3.11",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:watch": "node esbuild.config.mjs --watch",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "bun run build:watch",
    "feedback": "bun run scripts/feedback.ts",
    "serve": "bun run build && bunx serve -l 5173 public",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@medv/finder": "^4.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
