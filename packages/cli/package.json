{
  "name": "@ccm-feedback/cli",
  "version": "0.4.3",
  "description": "CLI tool to set up CCM Feedback in your project",
  "type": "module",
  "bin": {
    "ccm-feedback": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ccm-feedback",
    "cli",
    "prisma",
    "setup",
    "developer-tools",
    "feedback",
    "nextjs",
    "prisma-generator",
    "typescript"
  ],
  "author": "ccmdesign",
  "license": "MIT",
  "homepage": "https://feedback.ccmdesign.ca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccmdesign/ccm-feedback-tool.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ccmdesign/ccm-feedback-tool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@ccm-feedback/core": "workspace:*",
    "commander": "^14.0.3",
    "@clack/prompts": "^1.2.0",
    "@mrleebo/prisma-ast": "^0.15.0"
